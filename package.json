{
  "name": "astrofox",
  "version": "2.0.0",
  "productName": "Astrofox",
  "description": "Audio reactive motion graphics program",
  "author": "Mike Cao <mike@mikecao.com>",
  "license": "MIT",
  "homepage": "https://astrofox.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/astrofox-io/astrofox"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node ./scripts/copy-plugin-libs.mjs && dotenv next dev --turbo",
    "start": "next start",
    "build": "node ./scripts/copy-plugin-libs.mjs && next build --turbo",
    "preview": "next start",
    "lint": "biome check .",
    "lint-fix": "biome check . --write",
    "dev:desktop": "dotenv -- node ./scripts/dev-electron.mjs",
    "dev:desktop:update": "cross-env ASTROFOX_FAKE_UPDATE=available dotenv -- node ./scripts/dev-electron.mjs",
    "dev:desktop:update-none": "cross-env ASTROFOX_FAKE_UPDATE=none dotenv -- node ./scripts/dev-electron.mjs",
    "dev:desktop:update-error": "cross-env ASTROFOX_FAKE_UPDATE=error dotenv -- node ./scripts/dev-electron.mjs",
    "dev:plugins": "node ./scripts/dev-plugins.mjs",
    "build:renderer": "node ./scripts/copy-plugin-libs.mjs && cross-env BUILD_TARGET=desktop NODE_ENV=production next build --turbo",
    "build:desktop": "pnpm install-ffmpeg && pnpm build:renderer && electron-builder --publish never",
    "package": "pnpm package:dir",
    "package:dir": "pnpm install-ffmpeg && pnpm build:renderer && electron-builder --dir",
    "package:mac": "pnpm install-ffmpeg && pnpm build:renderer && electron-builder --mac --publish never",
    "package:win": "pnpm install-ffmpeg && pnpm build:renderer && electron-builder --win --publish never",
    "package:win:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-win-signed.ps1",
    "package:linux": "pnpm install-ffmpeg && pnpm build:renderer && electron-builder --linux --publish never",
    "dist:win": "pnpm install-ffmpeg && pnpm build:renderer && electron-builder --win --publish never",
    "dist:mac": "pnpm install-ffmpeg && pnpm build:renderer && electron-builder --mac --publish never",
    "dist:linux": "pnpm install-ffmpeg && pnpm build:renderer && electron-builder --linux --publish never",
    "install-ffmpeg": "node ./scripts/install-ffmpeg.mjs",
    "plugin-libs": "node ./scripts/copy-plugin-libs.mjs",
    "postinstall": "node ./scripts/copy-plugin-libs.mjs"
  },
  "build": {
    "appId": "io.astrofox.app",
    "productName": "Astrofox",
    "executableName": "Astrofox",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "astrofox-io",
        "repo": "astrofox"
      }
    ],
    "afterPack": "scripts/configure-update-feed.cjs",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/electron-updater/**",
      "node_modules/builder-util-runtime/**",
      "node_modules/fs-extra/**",
      "node_modules/graceful-fs/**",
      "node_modules/jsonfile/**",
      "node_modules/universalify/**",
      "node_modules/js-yaml/**",
      "node_modules/argparse/**",
      "node_modules/lazy-val/**",
      "node_modules/lodash.escaperegexp/**",
      "node_modules/lodash.isequal/**",
      "node_modules/semver/**",
      "node_modules/tiny-typed-emitter/**",
      "node_modules/debug/**",
      "node_modules/ms/**",
      "node_modules/sax/**",
      "!**/*.{md,map}",
      "!.git/**/*",
      "!.next/**/*",
      "!src/**/*",
      "!messages/**/*",
      "!release/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "${productName}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "category": "public.app-category.video",
      "icon": "public/icons/icon-512.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Astrofox needs microphone access for audio input.",
        "NSScreenCaptureUsageDescription": "Astrofox needs screen recording access to capture the desktop."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "AudioVideo",
      "icon": "public/icons/icon-512.png",
      "maintainer": "Astrofox <mike@mikecao.com>",
      "artifactName": "${productName}-linux-${arch}.${ext}"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-three/fiber": "^9.6.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.3.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.0.6",
    "debug": "^4.3.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "fourier-transform": "^2.3.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^1.21.0",
    "mime": "^4.1.0",
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^4.11.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "window-function": "^3.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.184.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "get-port": "^7.2.0",
    "typescript": "6.0.3",
    "wait-on": "^8.0.4"
  }
}
